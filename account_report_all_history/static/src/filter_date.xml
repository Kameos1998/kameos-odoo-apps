<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!-- Range mode only: the `_range` divider does not exist in single-date mode.
         No JS: the standard selectDateFilter() passes `all_history` through
         unchanged (getDateFilter returns unknown types as is) and reloads; the
         Enter key goes through the same path thanks to data-period-type. -->
    <t t-name="account_report_all_history.AccountReportFilterDate" t-inherit="account_reports.AccountReportFilterDate" t-inherit-mode="extension">
        <xpath expr="//div[@id='filter_date_divider_range']" position="before">
            <DropdownItem
                tag="'div'"
                class="{
                    'd-flex justify-content-between date_filter o_all_history': true,
                    'selected': this.isPeriodSelected('all_history'),
                }"
                attrs="{ 'data-period-type': 'all_history' }"
                onSelected="() => this.selectDateFilter('all_history', true)"
                closingMode="'none'"
            >
                <div class="filter_name pe-3">All history</div>
            </DropdownItem>
        </xpath>
    </t>
</templates>
