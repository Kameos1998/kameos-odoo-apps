msgstr "Glisser pour redimensionner — double-cliquer pour réinitialiser"

#. module: chatter_position
#. odoo-javascript
#: code:addons/chatter_position/static/src/chatter_position.js:0
msgid "Move chatter to the bottom"
msgstr "Déplacer le chatter en bas"

#. module: chatter_position
#. odoo-javascript
#: code:addons/chatter_position/static/src/chatter_position.js:0
msgid "Move chatter to the side"
msgstr "Déplacer le chatter sur le côté"

#. module: chatter_position
#: model:ir.module.module,summary:base.module_chatter_position
msgid "Toggle the chatter between side and bottom, with a draggable splitter."
msgstr "Basculez le chatter entre le côté et le bas, avec un séparateur à faire glisser."
